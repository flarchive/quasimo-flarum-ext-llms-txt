{
    "name": "quasimo/flarum-ext-llms-txt",
    "description": "Flarum extension that auto-generates llms.txt and llms-full.txt for LLM-friendly content discovery",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": ["flarum", "extension", "llms", "llms.txt", "ai", "llm"],
    "authors": [
        {
            "name": "Quasimo",
            "homepage": "https://github.com/Quasimo"
        }
    ],
    "require": {
        "flarum/core": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Quasimo\\LlmsTxt\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "LLMs.txt Generator",
            "category": "feature",
            "icon": {
                "name": "fas fa-robot",
                "backgroundColor": "#4F46E5",
                "color": "#ffffff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
